# Copy to .env and fill in. Never commit .env. Setup: docs/admin-installation-guide.md
# Generate each secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Server name in the browser address bar; must match the HTTPS certificate in deploy/certs.
SERVER_NAME=adgvs.school.edu.ph
# Time zone for the daily jobs (POSIX form works in every container; PHT-8 = UTC+8).
TZ=PHT-8

# Database owner: used only by migrations and backups.
POSTGRES_USER=adgvs
POSTGRES_PASSWORD=
POSTGRES_DB=adgvs
# Login the API uses: data access only, audit log insert-only (created by `migrate`).
ADGVS_APP_DB_USER=adgvs_app
ADGVS_APP_DB_PASSWORD=

# Backups (daily, encrypted). Keep the passphrase somewhere safe OFF the server:
# without it the backups cannot be restored.
BACKUP_PASSPHRASE=
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=30
# A disk or NAS mount that is not the server's system disk (one copy off-server).
BACKUP_DIR=./backups
# Download-window expiry job (Section 14).
JOBS_TIME=01:00

# Backend (prefix ADGVS_)
# Signs download links. Changing it invalidates links already handed out (5-minute life).
ADGVS_SECRET_KEY=
# Set to false only for local http development; production must stay true (HTTPS).
ADGVS_COOKIE_SECURE=true
ADGVS_SESSION_IDLE_MINUTES=30
# The web app and API share one origin behind Nginx, so no cross-origin access is needed.
ADGVS_CORS_ORIGINS=[]
# Interactive API docs (/docs). Keep off in production; docs/api/openapi.json is the reference.
ADGVS_API_DOCS=false
API_WORKERS=2

# Request workflow (Section 14)
ADGVS_PAYMENT_REQUIRED=false
ADGVS_AUTO_RELEASE_ON_APPROVAL=true
ADGVS_DOWNLOAD_WINDOW_DAYS=30

# Validation thresholds (Section 15); tune with real scans
ADGVS_OCR_CONFIDENCE_THRESHOLD=90
ADGVS_NAME_REVIEW_SIMILARITY=0.90

# Printed on every document. [Assumption] placeholders until the school confirms.
ADGVS_INSTITUTION_NAME=Sample State University
ADGVS_INSTITUTION_ADDRESS=Sample City, Philippines
ADGVS_REGISTRAR_NAME=MA. CLARA D. REYES
ADGVS_REGISTRAR_TITLE=University Registrar

# Cloud (Render + Supabase, docs/cloud-deployment.md); leave as is on-prem.
# Storage: local (on-prem) or supabase (cloud, private bucket, server-side secret key only).
ADGVS_STORAGE_BACKEND=local
ADGVS_SUPABASE_URL=
ADGVS_SUPABASE_SERVICE_KEY=
ADGVS_STORAGE_BUCKET=adgvs-private
# Proxies that append to X-Forwarded-For: 0 on-prem (Nginx), 2 on Render behind Vercel.
ADGVS_TRUSTED_PROXY_HOPS=0
# Daily-jobs endpoint secret (16+ chars); same value as CRON_SECRET in Vercel. Empty = off.
ADGVS_CRON_SECRET=
# Database pool per worker (Render Free: 3 and 2).
ADGVS_DB_POOL_SIZE=5
ADGVS_DB_MAX_OVERFLOW=10
# Stored scan pages: grayscale JPEG, A4 at 200 dpi.
ADGVS_SCAN_PAGE_MAX_WIDTH=1654
ADGVS_SCAN_PAGE_JPEG_QUALITY=70
