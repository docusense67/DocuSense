# HTTPS front door (Section 18 Transport). ${SERVER_NAME} is filled in from .env when the
# container starts. Certificates: deploy/certs/fullchain.pem and privkey.pem.

# Login throttle per client IP. Generous on purpose: a whole campus may share one NAT
# address (100 students signing in within a minute at peak, Section 21); per-account lockout
# (5 failures, 15 minutes) is the main defence against password guessing.
limit_req_zone $binary_remote_addr zone=login:10m rate=5r/s;

server {
    listen 80;
    server_name ${SERVER_NAME};
    server_tokens off;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_tickets off;

    # Scan uploads are capped at 15 MB per image by the API; leave headroom for multipart.
    client_max_body_size 20m;

    # Applies only where a location adds no headers of its own (nginx inheritance rule):
    # /api/ responses get their other security headers from the app.
    add_header Strict-Transport-Security "max-age=31536000" always;

    location /api/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $http_host;  # keeps a non-default port for the Origin check
        proxy_set_header X-Forwarded-For $remote_addr;  # replace, never append: clients cannot spoof audit IPs
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;  # bulk scan submissions and TOR generation
    }

    location = /api/auth/login {
        limit_req zone=login burst=50 nodelay;
        limit_req_status 429;
        proxy_pass http://api:8000;
        proxy_set_header Host $http_host;  # keeps a non-default port for the Origin check
        proxy_set_header X-Forwarded-For $remote_addr;  # replace, never append: clients cannot spoof audit IPs
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    root /usr/share/nginx/html;

    # Hashed build assets never change; cache them for a year.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Single-page app: unknown paths load index.html, which is never cached.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
