# ADGVS applicant intake OCR worker (docs/applicant-intake.md).
# Installed by deploy/station/pi-setup.sh to /etc/systemd/system/adgvs-applicant-worker.service
# but not enabled: turn it on where applicants' online uploads should be read.
#
#   sudo systemctl enable --now adgvs-applicant-worker
#   sudo systemctl status adgvs-applicant-worker      journalctl -u adgvs-applicant-worker -f
#
# Claims online TOR/COE submissions from the API with the station key, reads them with
# Tesseract and sends the reading back (scan_agent/applicant_worker.py). It needs no scanner,
# camera or GPIO, only the network. Same settings file as the station: /etc/adgvs/station.env
# (ADGVS_SERVER, ADGVS_STATION_KEY, ADGVS_CA_CERT, TESSERACT_CMD). In the cloud setup
# ADGVS_SERVER is the Render API address, not the Vercel site.

[Unit]
Description=ADGVS applicant intake OCR worker (online uploads -> reading)
Documentation=file:///opt/adgvs/scan-agent/README.md
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=adgvs-agent
Group=adgvs-agent
Environment=TESSERACT_CMD=/usr/bin/tesseract
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/adgvs/station.env
ExecStart=/opt/adgvs/venv/bin/python -m scan_agent.applicant_worker
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=always
RestartSec=10
# Shares the Pi's CPU with the station: stay behind it when both are busy.
Nice=10

# ---- hardening ------------------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
